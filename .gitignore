# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Node.js dependencies and package-manager caches
node_modules/
.npm/
.yarn/cache/
.yarn/unplugged/
.pnp.*

# Next.js build output and caches
.next/
out/
.turbo/
.vercel/
frontend/coverage/

# Frontend environment variables (keep templates)
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
backend/.venv/
backend/venv/
backend/env/

# Python test, type-checking, linting, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Backend environment variables (keep templates)
backend/.env
backend/.env.*
!backend/.env.example

# Root environment variables (keep templates)
.env
.env.*
!.env.example

# SQLite databases and runtime sidecar files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Application and package-manager logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and editor-generated files
.vscode/
.idea/
*.swp
*.swo
*~

# Root-level local scratch files
/temp.*
